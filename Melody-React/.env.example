# Melody - environment template.
# Copy this file to .env (local) and/or fill the same names in Vercel →
# Project → Settings → Environment Variables. NEVER commit the real .env.

# ---------------------------------------------------------------- client ---
# Bundled into the browser build. Safe to expose: the anon key only works
# together with the Row Level Security policies in supabase_schema.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------- server ---
# Used by api/*.js (and scripts/dev-api.mjs) to verify session tokens.
# Falls back to the VITE_ values above when unset, so in practice the two
# VITE_ variables are the only ones you must provide.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# NOTE: never put the service_role key here or anywhere in this project.

# ----------------------------------------------------------------- Audius ---
# Optional. Without them Melody runs keyless against the public endpoints
# (app_name=Melody). Add a free key/token from https://api.audius.co/plans
# if Audius asks for credentials: 10 requests/second on the free plan.
AUDIUS_APP_NAME=Melody
AUDIUS_API_KEY=
AUDIUS_BEARER_TOKEN=
# Alternative to the bearer token (Basic auth with the key):
AUDIUS_API_SECRET=
# Only override these if Audius changes them:
# AUDIUS_API_BASE=https://api.audius.co/v1
