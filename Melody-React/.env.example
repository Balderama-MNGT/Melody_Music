# Melody - environment template.
# Copy this file to .env (local) and/or fill the same names in Vercel →
# Project → Settings → Environment Variables. NEVER commit the real .env.

# ---------------------------------------------------------------- client ---
# Bundled into the browser build. Safe to expose: the anon key only works
# together with the Row Level Security policies in supabase_schema.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --------------------------------------------------------------- YouTube ---
# SERVER-SIDE ONLY. The browser NEVER receives this key. Set it as
# YOUTUBE_API_KEY in .env for `npm run dev:api`, and as a (non-VITE) environment
# variable in Vercel -> Settings -> Environment Variables. Remove the old
# VITE_YOUTUBE_API_KEY from Vercel after deploying the /api/music function.
# Restrict the key to YouTube Data API v3 and watch its daily quota in
# Google Cloud Console -> APIs & Services -> Dashboard.
YOUTUBE_API_KEY=

# Temporary compatibility setting: if the key still has an HTTP-referrer
# restriction, set the allowed origin here so server-side calls include it.
# Preferred long-term fix: remove the referrer restriction and restrict the
# key to this server's IP address instead.
YOUTUBE_REFERER=http://localhost:5173/

# Optional identity: the browser sends its Supabase access token to /api/music
# so the backend can apply per-user limits in addition to per-IP limits.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ----------------------------------------------------------- rate limits ---
# All values are optional; defaults are shown. Limits are per window per IP,
# with separate buckets for signed-in users and per endpoint. A normal song
# change is client-side only and never touches these counters.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_IP_MAX=120
RATE_LIMIT_USER_MAX=240
# search is the only quota-spending action; recommendation refills use it too
RATE_LIMIT_SEARCH_IP_MAX=30
RATE_LIMIT_SEARCH_USER_MAX=60
# cheap cached lists and artist lookups have their own allowances
RATE_LIMIT_CHART_IP_MAX=120
RATE_LIMIT_CHART_USER_MAX=240
RATE_LIMIT_ARTIST_IP_MAX=60
RATE_LIMIT_ARTIST_USER_MAX=120

# --------------------------------------------------------------- caching ---
CACHE_SEARCH_TTL_MS=900000
# Empty searches must expire quickly so a gap can never look permanent
CACHE_EMPTY_SEARCH_TTL_MS=60000
CACHE_VIDEO_TTL_MS=3600000
CACHE_CHART_TTL_MS=600000
CACHE_ARTIST_TTL_MS=1200000
CACHE_CHANNEL_TTL_MS=900000
CACHE_MAX_ENTRIES=500

# ------------------------------------------------------ recommendations ----
# One cache entry per seed song. Empty results expire fast; a genuine set is
# reused for 10 minutes. Fallback searches are bounded (never unlimited).
RECOMMEND_CACHE_TTL_MS=600000
RECOMMEND_EMPTY_TTL_MS=60000
RECOMMEND_MAX_QUERIES=3
RECOMMEND_MIN_RESULTS=6

# ------------------------------------------------- quota / upstream safety --
YOUTUBE_QUOTA_DAILY=10000
YOUTUBE_TIMEOUT_MS=12000
YOUTUBE_MAX_RETRIES=2
ALLOWED_ORIGINS=http://localhost:5173,https://melody-music-ten.vercel.app

# ------------------------------------------------------- play recording ----
# A play is recorded only after this many milliseconds of actual listening.
# VITE_MIN_PLAY_MS is the client timer; MIN_PLAY_MS is the server-side floor
# (both should be the same). Apply supabase_play_idempotency_migration.sql first.
VITE_MIN_PLAY_MS=3000
MIN_PLAY_MS=3000
PLAYS_LIMIT_PER_MINUTE=20

# Multi-instance cache: on Vercel every serverless instance has its own memory.
# For shared rate limits AND shared cache, set an Upstash Redis REST database.
# Without it the app still works, but counters/caches are per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --------------------------------------------------------------- server ---
# Read by scripts/dev-api.mjs (npm run dev:api).
